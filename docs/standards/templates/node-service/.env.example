# Template: container-first standard. Copy to .env and fill in.
#
#   cp .env.example .env
#
# The real .env is gitignored. Confirm THIS file is not — an `.env.*` rule
# silently swallows it, so the .gitignore needs `!.env.example`.

# Host port to publish on. Pick from the documented range and check it is free:
#   netstat -ano | grep ":3200" | grep LISTENING
<SERVICE>_PORT=3200

# Secrets — never bake these into the image.
# SOME_API_KEY=
