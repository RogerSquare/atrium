# Dependencies
node_modules/

# Runtime secrets
backend/.jwt-secret
*.env
.env.*

# User data & credentials
backend/users/
backend/chat/
backend/ai-history/

# Auto-Enter prompt-capture log (runtime analysis data)
backend/autoenter/

# Agent token metadata — keep blocklist tracked, exclude individual issued-token files
backend/agent-tokens/*.json
!backend/agent-tokens/.blocklist.json

# Task history & trash
backend/tasks/.history/
backend/tasks/.trash/

# Task files (contain project-specific data)
backend/tasks/**/*.md

# Runtime uploads
backend/uploads/

# Playwright e2e run artifacts (per-task subdirs)
backend/e2e-runs/

# Design sessions
backend/design-history/
backend/design-sessions/

# Machine-specific config
backend/settings.json
backend/services.json

# GitHub-watcher loops (runtime data)
backend/loops.json

# Claude Code local config — ignore everything by default but track project-shared skills
.claude/*
!.claude/skills/

# Backups
source_backups/

# Runtime files
task_review.json

# Build output
dist/
dist-ssr/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
