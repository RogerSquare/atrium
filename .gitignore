# Dependencies
node_modules/

# Runtime secrets
backend/.jwt-secret
*.env
.env.*
# ...but the container config TEMPLATE must ship — `.env.*` above would
# otherwise swallow it and a fresh clone would have nothing to copy from.
!.env.example

# User data & credentials
backend/users/
backend/chat/
backend/ai-history/

# Auto-Enter prompt-capture log (runtime analysis data)
backend/autoenter/

# Agent token metadata — keep blocklist tracked, exclude individual issued-token files
backend/agent-tokens/*.json
!backend/agent-tokens/.blocklist.json

# Task history & trash
backend/tasks/.history/
backend/tasks/.trash/

# Task files (contain project-specific data)
backend/tasks/**/*.md

# Runtime uploads
backend/uploads/

# Playwright e2e run artifacts (per-task subdirs)
backend/e2e-runs/

# Design sessions
backend/design-history/
backend/design-sessions/

# Machine-specific config
backend/settings.json
backend/services.json
backend/projects.json

# GitHub-watcher loops (runtime data)
backend/loops.json
backend/loop-runs/
backend/loop-templates.json

# Transient agent prompt files (written under ATRIUM_DATA_DIR, which defaults to
# backend/ on a native install) — devops-agent-contract-001
backend/.agent-prompt-*.txt

# Optional untracked agent house-rules overlay appended to CLAUDE.md
CLAUDE.local.md

# Claude Code local config — ignore everything by default but track project-shared skills
.claude/*
!.claude/skills/

# Backups
source_backups/

# Runtime files
task_review.json

# Build output
dist/
dist-ssr/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
