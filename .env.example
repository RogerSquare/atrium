# Atrium container configuration (devops-docker-compose-001).
#
#   cp .env.example .env
#
# Then fill in the values below. The real .env is gitignored (`*.env` in
# .gitignore matches it) — never commit it.

# --- Required ---------------------------------------------------------------

# Signs the JWTs for user and agent sessions. The backend refuses to start in
# production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# Changing this invalidates every existing login and agent token.
JWT_SECRET=

# Your projects directory on the host, bind-mounted to /workspace inside the
# container. This is what the Changes view runs git/gh against and what the
# web-shell opens into. Windows paths work as-is in compose.
#
#   ATRIUM_WORKSPACE=C:\Users\YourName\Documents\opencode
ATRIUM_WORKSPACE=

# Your Claude Code config directory, mounted read-only so the container can
# authenticate. Usually %USERPROFILE%\.claude
#
#   ATRIUM_CLAUDE_CONFIG=C:\Users\YourName\.claude
ATRIUM_CLAUDE_CONFIG=

# --- Optional ---------------------------------------------------------------

# Host port to publish the board on. Change this if 3001 is already taken by
# a native Atrium instance you are still running.
ATRIUM_PORT=3001

# GitHub token for the Changes view's PR badges. Without it, git operations
# still work and only the PR/branch badges go quiet. Needs `repo` scope for
# private repositories.
GH_TOKEN=

# Extra browser origins allowed to call the API, comma-separated. Same-origin
# access needs no entry — set this only if you front the container with a
# different hostname (e.g. https://board.example.com).
ALLOWED_ORIGINS=

# Socket.IO handshake authentication. Defaults to ON: every socket must present
# a valid session/agent JWT, so the embedded terminals (which spawn real shells)
# cannot be opened by an unauthenticated client. Set to "off" ONLY as a
# temporary escape hatch if a legacy client cannot yet send a token — this
# override will be removed in a future release. Leave unset for the secure
# default.
# ATRIUM_SOCKET_AUTH=off

# --- Shared-task mode (optional, advanced) ----------------------------------
#
# Only needed if you run with the shared-tasks override:
#   docker compose -f docker-compose.yml -f docker-compose.shared-tasks.yml up -d
#
# That points the container at the NATIVE install's live task files instead of
# keeping its own copy in the volume, so both instances read and write the same
# data. Read docker-compose.shared-tasks.yml before enabling — the headline
# risk is lost updates when both instances touch the same task at once.
ATRIUM_SHARED_TASKS=
ATRIUM_SHARED_PROJECTS=

# --- Docker-managed services (optional, advanced) ---------------------------
#
# Only used with the docker-services override:
#   docker compose -f docker-compose.yml -f docker-compose.docker-services.yml up -d
#
# Restricts which container NAMES the socket allow-list proxy will act on at
# all. Empty means any container on this host. Setting it shrinks the blast
# radius if Atrium is ever compromised, e.g. "artifex,memos".
ATRIUM_ALLOWED_CONTAINERS=

# Ephemeral test-job containers (devops-runner-proxy-jobs-001). EMPTY means the
# capability is OFF — the proxy exposes no create/wait/remove shapes at all,
# NOT "any image". Set to a comma-separated allow-list of exact image refs
# (e.g. "swift:6" or "swift:6,mcr.microsoft.com/dotnet/sdk:8.0") to let test
# runners create unprivileged, non-publishing atrium-job-* containers from
# those images only. Images must already be pulled — the proxy grants no pull.
ATRIUM_RUNNER_IMAGES=

# Host path job containers may bind-mount READ-ONLY (the source checkout the
# tests run against), e.g. C:/Users/you/Documents/opencode. Empty means job
# containers get no binds at all.
ATRIUM_RUNNER_WORKSPACE=

# Claude Code account/onboarding state. Lives OUTSIDE the .claude directory, so
# it needs its own mount — without it the container cannot remember your login
# across rebuilds. Usually %USERPROFILE%\.claude.json
ATRIUM_CLAUDE_JSON=

# Agent token for the atrium MCP server, so a terminal inside the container
# gets the atrium_* tools. Mint one in Settings -> Agent Tokens (admin only);
# it is shown once. Without it the MCP server starts but every call 401s.
ATRIUM_API_TOKEN=

# --- Advanced / rarely needed overrides -------------------------------------
#
# You almost never set these by hand — the defaults are right for both the
# native run and the container. Listed here so every env var the code reads has
# a documented home. All are commented out (unset) by default.

# Root directory for ALL mutable state (tasks, users, chat, uploads, .jwt-secret,
# ...). Defaults to backend/ on a native install; the container sets it to /data
# so one volume holds everything.
# ATRIUM_DATA_DIR=/data

# Seeds settings.json's workingDirectory on the FIRST boot only (never
# overwrites an existing settings.json). The container points this at /workspace.
# ATRIUM_WORKING_DIRECTORY=/workspace

# Turn the Services manager off ("0"/"false"/"off"). The base container compose
# sets this because a container cannot spawn host processes; a native install
# leaves it on.
# ATRIUM_FEATURE_SERVICES=off

# Docker Engine API endpoint for container-typed services. Set by the
# docker-services override to the allow-list proxy; unset otherwise.
# DOCKER_HOST=http://docker-socket-proxy:2375

# Path to the built frontend to serve. Defaults to frontend/dist; set only if
# you build the SPA somewhere else.
# ATRIUM_FRONTEND_DIST=

# Interactive shell for the web terminal. The image defaults to /bin/bash.
# ATRIUM_SHELL=/bin/bash
# WEB_SHELL_DEFAULT_SHELL=
# WEB_SHELL_CLAUDE_BIN=

# Shared secret guarding the public Auto-Enter hook receiver
# (POST /api/autoenter/hook). Only needed if you wire up the Claude Code hook.
# ATRIUM_HOOK_TOKEN=

# Max seconds the atrium_wait_for_next_todo long-poll holds a request open
# (server cap; default 300).
# ATRIUM_WAIT_MAX_SECONDS=300

# Loop-engine state file locations. Overridden only by the loop test scripts;
# leave unset for the DATA_DIR defaults.
# ATRIUM_LOOPS_FILE=
# ATRIUM_LOOP_RUNS_DIR=
# ATRIUM_LOOP_TEMPLATES_FILE=
