{
  "suites": [
    {
      "id": "node-unit",
      "label": "Node built-in test runner (local, zero deps)",
      "runner": "command",
      "cwd": "node",
      "command": "node --test --test-reporter junit --test-reporter-destination junit.xml math.test.mjs",
      "report": "junit-xml",
      "reportPath": "junit.xml",
      "target": "local"
    },
    {
      "id": "node-unit-fail-demo",
      "label": "Node suite with DEMO_FAIL=1 (proves the red path)",
      "runner": "command",
      "cwd": "node",
      "command": "node --test --test-reporter junit --test-reporter-destination junit.xml math.test.mjs fail-demo.test.mjs",
      "report": "junit-xml",
      "reportPath": "junit.xml",
      "target": "local"
    },
    {
      "id": "pytest-unit",
      "label": "pytest (Python container)",
      "runner": "command",
      "cwd": "pytest",
      "command": "pip install -q pytest && pytest -q --junitxml=junit.xml",
      "report": "junit-xml",
      "reportPath": "junit.xml",
      "target": "container:python:3.12-slim"
    }
  ]
}
